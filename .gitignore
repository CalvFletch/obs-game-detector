# Exclude everything
/*

# Except for default project files
!/.github
!/build-aux
!/cmake
!/data
!/src
!/.clangd
!.clang-format
!.gersemirc
!.gitignore
!/tools/update-compile-commands.ps1
!buildspec.json
!CMakeLists.txt
!CMakePresets.json
!LICENSE
!README.md
!BUILD.md

# Exclude lock files
*.lock.json

# Exclude macOS legacy resource forks
.DS_Store

# Exclude CMake build number cache
/cmake/.CMakeBuildNumber
